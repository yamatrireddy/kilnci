# SPDX-License-Identifier: Apache-2.0
# Exact versions in package.json; lockfile is the source of truth.
save-exact=true
# Wait 7 days before resolving newly published versions (npm >= 11.10).
min-release-age=7
engine-strict=true
strict-peer-dependencies=true
auto-install-peers=false
# pnpm 10 blocks dependency lifecycle scripts unless allow-listed in
# package.json "pnpm.onlyBuiltDependencies". Keep that list minimal.
